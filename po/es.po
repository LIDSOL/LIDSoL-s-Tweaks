msgstr "Controla cómo se muestra la información de reproducción multimedia en el panel."

#: prefs.js:1074
msgid "Media module"
msgstr "Módulo multimedia"

#: prefs.js:1075
msgid "Shows the current track information in the panel during playback"
msgstr "Muestra la información de la pista actual en el panel durante la reproducción"

#: prefs.js:1086
msgid "Only show during playback"
msgstr "Solo mostrar durante reproducción"

#: prefs.js:1087
msgid "If inactive, media information is shown even when the media is paused"
msgstr "Si está inactivo, la información multimedia se muestra incluso cuando el medio está en pausa"

#: prefs.js:1096
msgid "Title length"
msgstr "Longitud del título"

#: prefs.js:1097
msgid "Maximum characters for the track title (5-30)"
msgstr "Máximo de caracteres para el título de la pista (5-30)"

#: prefs.js:1106
msgid "Artist length"
msgstr "Longitud del artista"

#: prefs.js:1107
msgid "Maximum characters for the artist name (5-30)"
msgstr "Máximo de caracteres para el nombre del artista (5-30)"

#: prefs.js:1118
msgid "Shows the album art next to the track information"
msgstr "Muestra la carátula del álbum junto a la información de la canción"

#: prefs.js:1135
msgid "Art cache size"
msgstr "Tamaño de caché de carátulas"

#: prefs.js:1136
msgid "Maximum disk storage limit (MB). Old covers are removed automatically."
msgstr "Límite máximo de almacenamiento en disco (MB). Las carátulas antiguas se eliminan automáticamente."

#: prefs.js:1151
msgid "Enable visualizer"
msgstr "Activar visualizador"

#: prefs.js:1152
msgid "Shows the audio visualizer during playback"
msgstr "Muestra el visualizador de audio durante la reproducción"

#: prefs.js:1162
msgid "Bars"
msgstr "Barras"

#: prefs.js:1163
msgid "Number of visualizer bars"
msgstr "Cantidad de barras del visualizador"

#: prefs.js:1170
msgid "Visualizer height in pixels"
msgstr "Altura en píxeles del visualizador"

#: prefs.js:1194
msgid "Media view"
msgstr "Vista multimedia"

#: prefs.js:1195
msgid "Clock view"
msgstr "Vista de reloj"

#: prefs.js:1196
msgid "Clock + Media"
msgstr "Reloj + Medios"

#: prefs.js:1203
msgid "Media (text only), Clock (clock+art+visualizer), Full (text+clock)"
msgstr "Multimedia (solo texto), Reloj (reloj+carátula+visualizador), Completa (texto+reloj)"

#: prefs.js:1242
msgid "Wave"
msgstr "Onda"

#: prefs.js:1242
msgid "Beat"
msgstr "Latido"

#: prefs.js:1242
msgid "Cava"
msgstr "Cava"

#: prefs.js:1247
msgid "Visualizer style"
msgstr "Estilo del visualizador"

#: prefs.js:1248
msgid "Wave (sine), Beat (pulse), Cava (FFT, requires cava)"
msgstr "Onda (seno), Latido (pulso), Cava (FFT, requiere cava)"

#: prefs.js:1282
msgid "Art position"
msgstr "Ubicación de la carátula"

#: prefs.js:1283
msgid "Places the album art to the left or right of the text"
msgstr "Coloca la carátula a la izquierda o derecha del texto"

#: prefs.js:1317
msgid "Visualizer position"
msgstr "Ubicación del visualizador"

#: prefs.js:1318
msgid "Places the visualizer to the left or right of the text"
msgstr "Coloca el visualizador a la izquierda o derecha del texto"

#: prefs.js:1355
msgid "Font"
msgstr "Fuente"

#: prefs.js:1355
msgid "Font name (e.g. Monospace)"
msgstr "Nombre de la fuente (ej: Monospace)"

