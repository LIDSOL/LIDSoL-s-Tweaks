<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema path="/org/gnome/shell/extensions/lidsol-widgets/"
          id="org.gnome.shell.extensions.lidsol-widgets">

    <!-- Panel Corners -->
    <key type="b" name="panel-corners-enabled">
      <default>true</default>
      <summary>Habilitar esquinas redondeadas del panel</summary>
      <description>Activa las esquinas redondeadas en la parte inferior del panel</description>
    </key>

    <key type="b" name="panel-corners">
      <default>true</default>
      <summary>Panel Corners</summary>
      <description>Mostrar esquinas redondeadas en el panel</description>
    </key>

    <key type="i" name="panel-corner-radius">
      <default>12</default>
      <summary>Radio de las esquinas</summary>
      <description>Radio de las esquinas redondeadas</description>
    </key>

    <key type="i" name="panel-corner-border-width">
      <default>0</default>
      <summary>Ancho del borde</summary>
      <description>Ancho adicional para las esquinas</description>
    </key>

    <key type="s" name="panel-corner-background-color">
      <default>"#000000ff"</default>
      <summary>Color de fondo</summary>
      <description>Color de fondo de las esquinas del panel (formato CSS)</description>
    </key>

    <key type="d" name="panel-corner-opacity">
      <default>1</default>
      <summary>Opacidad</summary>
      <description>Opacidad de las esquinas</description>
    </key>

    <key type="b" name="screen-corners">
      <default>true</default>
      <summary>Screen Corners</summary>
      <description>Mostrar esquinas redondeadas en las esquinas de la pantalla</description>
    </key>

    <key type="i" name="screen-corner-radius">
      <default>12</default>
      <summary>Radio de las esquinas</summary>
      <description>Radio de las esquinas redondeadas de la pantalla</description>
    </key>

    <key type="s" name="screen-corner-background-color">
      <default>"#000000ff"</default>
      <summary>Color de fondo</summary>
      <description>Color de fondo de las esquinas de la pantalla (formato CSS)</description>
    </key>

    <key type="d" name="screen-corner-opacity">
      <default>1</default>
      <summary>Opacidad</summary>
      <description>Opacidad de las esquinas de la pantalla</description>
    </key>

    <key type="b" name="force-extension-values">
      <default>true</default>
      <summary>Forzar valores de la extensión</summary>
      <description>Forzar el uso de los valores de la extensión, ignorando el tema</description>
    </key>

    <key type="b" name="debug">
      <default>false</default>
      <summary>Modo debug</summary>
      <description>Activar modo debug (logs más verbosos)</description>
    </key>

    <!-- Workspace Indicator (Space Bar) -->
    <key type="b" name="workspace-indicator-enabled">
      <default>true</default>
      <summary>Habilitar indicador de espacios de trabajo</summary>
      <description>Reemplaza el indicador nativo de espacios de trabajo por uno configurable</description>
    </key>

    <!-- State -->
    <key type="i" name="ws-version">
      <default>0</default>
    </key>
    <key type="s" name="ws-workspace-names-map">
      <default>'{}'</default>
    </key>

    <!-- Behavior -->
    <key type="s" name="ws-indicator-style">
      <choices>
        <choice value="current-workspace" />
        <choice value="workspaces-bar" />
      </choices>
      <default>"workspaces-bar"</default>
    </key>
    <key type="b" name="ws-enable-custom-label">
      <default>false</default>
    </key>
    <key type="b" name="ws-enable-custom-label-in-menu">
      <default>false</default>
    </key>
    <key type="s" name="ws-custom-label-named">
      <default>'{{name}}'</default>
    </key>
    <key type="s" name="ws-custom-label-unnamed">
      <default>'Workspace {{number}}'</default>
    </key>
    <key type="s" name="ws-position">
      <choices>
        <choice value="left" />
        <choice value="center" />
        <choice value="right" />
      </choices>
      <default>"left"</default>
    </key>
    <key type="b" name="ws-system-workspace-indicator">
      <default>false</default>
    </key>
    <key type="i" name="ws-position-index">
      <range min="0" max="100" />
      <default>1</default>
    </key>
    <key type="b" name="ws-always-show-numbers">
      <default>false</default>
    </key>
    <key type="b" name="ws-show-empty-workspaces">
      <default>true</default>
    </key>
    <key type="b" name="ws-toggle-overview">
      <default>true</default>
    </key>
    <key type="s" name="ws-scroll-wheel">
      <choices>
        <choice value="panel" />
        <choice value="workspaces-bar" />
        <choice value="disabled" />
      </choices>
      <default>"panel"</default>
    </key>
    <key type="b" name="ws-scroll-wheel-debounce">
      <default>true</default>
    </key>
    <key type="i" name="ws-scroll-wheel-debounce-time">
      <default>200</default>
    </key>
    <key type="s" name="ws-scroll-wheel-vertical">
      <choices>
        <choice value="normal" />
        <choice value="inverted" />
        <choice value="disabled" />
      </choices>
      <default>"normal"</default>
    </key>
    <key type="s" name="ws-scroll-wheel-horizontal">
      <choices>
        <choice value="normal" />
        <choice value="inverted" />
        <choice value="disabled" />
      </choices>
      <default>"disabled"</default>
    </key>
    <key type="b" name="ws-scroll-wheel-wrap-around">
      <default>false</default>
    </key>
    <key type="b" name="ws-smart-workspace-names">
      <default>false</default>
    </key>
    <key type="b" name="ws-reevaluate-smart-workspace-names">
      <default>true</default>
    </key>

    <!-- Shortcuts -->
    <key type="b" name="ws-enable-activate-workspace-shortcuts">
      <default>false</default>
    </key>
    <key type="b" name="ws-back-and-forth">
      <default>false</default>
    </key>
    <key type="b" name="ws-enable-move-to-workspace-shortcuts">
      <default>false</default>
    </key>

    <key type="as" name="ws-move-workspace-left">
      <default><![CDATA[['<Control><Alt><Super>Left']]]></default>
    </key>
    <key type="as" name="ws-move-workspace-right">
      <default><![CDATA[['<Control><Alt><Super>Right']]]></default>
    </key>
    <key type="as" name="ws-activate-previous-key">
      <default><![CDATA[[]]]></default>
    </key>
    <key type="as" name="ws-activate-empty-key">
      <default><![CDATA[[]]]></default>
    </key>
    <key type="as" name="ws-open-menu">
      <default><![CDATA[['<Super>W']]]></default>
    </key>

    <key type="as" name="ws-activate-1-key">
      <default><![CDATA[['<Super>1']]]></default>
    </key>
    <key type="as" name="ws-activate-2-key">
      <default><![CDATA[['<Super>2']]]></default>
    </key>
    <key type="as" name="ws-activate-3-key">
      <default><![CDATA[['<Super>3']]]></default>
    </key>
    <key type="as" name="ws-activate-4-key">
      <default><![CDATA[['<Super>4']]]></default>
    </key>
    <key type="as" name="ws-activate-5-key">
      <default><![CDATA[['<Super>5']]]></default>
    </key>
    <key type="as" name="ws-activate-6-key">
      <default><![CDATA[['<Super>6']]]></default>
    </key>
    <key type="as" name="ws-activate-7-key">
      <default><![CDATA[['<Super>7']]]></default>
    </key>
    <key type="as" name="ws-activate-8-key">
      <default><![CDATA[['<Super>8']]]></default>
    </key>
    <key type="as" name="ws-activate-9-key">
      <default><![CDATA[['<Super>9']]]></default>
    </key>
    <key type="as" name="ws-activate-10-key">
      <default><![CDATA[['<Super>0']]]></default>
    </key>

    <!-- Appearance -->
    <key type="i" name="ws-workspaces-bar-padding">
      <default>12</default>
    </key>
    <key type="i" name="ws-workspace-margin">
      <default>4</default>
    </key>

    <key type="s" name="ws-active-workspace-background-color">
      <default>'rgba(255,255,255,0.3)'</default>
    </key>
    <key type="s" name="ws-active-workspace-text-color">
      <default>'rgba(255,255,255,1)'</default>
    </key>
    <key type="s" name="ws-active-workspace-border-color">
      <default>'rgba(0,0,0,0)'</default>
    </key>
    <key type="i" name="ws-active-workspace-font-size">
      <default>-1</default>
    </key>
    <key type="s" name="ws-active-workspace-font-weight">
      <choices>
        <choice value="100" /><choice value="200" /><choice value="300" />
        <choice value="400" /><choice value="500" /><choice value="600" />
        <choice value="700" /><choice value="800" /><choice value="900" />
      </choices>
      <default>"700"</default>
    </key>
    <key type="i" name="ws-active-workspace-border-radius">
      <default>4</default>
    </key>
    <key type="i" name="ws-active-workspace-border-width">
      <default>0</default>
    </key>
    <key type="i" name="ws-active-workspace-padding-h">
      <default>8</default>
    </key>
    <key type="i" name="ws-active-workspace-padding-v">
      <default>3</default>
    </key>

    <key type="s" name="ws-inactive-workspace-background-color">
      <default>'rgba(0,0,0,0)'</default>
    </key>
    <key type="s" name="ws-inactive-workspace-text-color">
      <default>'rgba(255,255,255,1)'</default>
    </key>
    <key type="s" name="ws-inactive-workspace-border-color">
      <default>'rgba(0,0,0,0)'</default>
    </key>
    <key type="i" name="ws-inactive-workspace-font-size">
      <default>-1</default>
    </key>
    <key type="s" name="ws-inactive-workspace-font-weight">
      <choices>
        <choice value="100" /><choice value="200" /><choice value="300" />
        <choice value="400" /><choice value="500" /><choice value="600" />
        <choice value="700" /><choice value="800" /><choice value="900" />
      </choices>
      <default>"700"</default>
    </key>
    <key type="i" name="ws-inactive-workspace-border-radius">
      <default>4</default>
    </key>
    <key type="i" name="ws-inactive-workspace-border-width">
      <default>0</default>
    </key>
    <key type="i" name="ws-inactive-workspace-padding-h">
      <default>8</default>
    </key>
    <key type="i" name="ws-inactive-workspace-padding-v">
      <default>3</default>
    </key>

    <key type="s" name="ws-empty-workspace-background-color">
      <default>'rgba(0,0,0,0)'</default>
    </key>
    <key type="s" name="ws-empty-workspace-text-color">
      <default>'rgba(255,255,255,0.5)'</default>
    </key>
    <key type="s" name="ws-empty-workspace-border-color">
      <default>'rgba(0,0,0,0)'</default>
    </key>
    <key type="i" name="ws-empty-workspace-font-size">
      <default>-1</default>
    </key>
    <key type="s" name="ws-empty-workspace-font-weight">
      <choices>
        <choice value="100" /><choice value="200" /><choice value="300" />
        <choice value="400" /><choice value="500" /><choice value="600" />
        <choice value="700" /><choice value="800" /><choice value="900" />
      </choices>
      <default>"700"</default>
    </key>
    <key type="i" name="ws-empty-workspace-border-radius">
      <default>4</default>
    </key>
    <key type="i" name="ws-empty-workspace-border-width">
      <default>0</default>
    </key>
    <key type="i" name="ws-empty-workspace-padding-h">
      <default>8</default>
    </key>
    <key type="i" name="ws-empty-workspace-padding-v">
      <default>3</default>
    </key>

    <key type="s" name="ws-application-styles">
      <default>''</default>
    </key>
    <key type="b" name="ws-custom-styles-enabled">
      <default>false</default>
    </key>
    <key type="b" name="ws-custom-styles-failed">
      <default>false</default>
    </key>
    <key type="s" name="ws-custom-styles">
      <default>''</default>
    </key>

    <key type="s" name="ws-transition-animation">
      <choices>
        <choice value="fade" />
        <choice value="soft-pulse" />
        <choice value="soft-slide" />
        <choice value="none" />
      </choices>
      <default>"fade"</default>
      <summary>Animación de transición entre espacios</summary>
      <description>Estilo de animación al cambiar de espacio de trabajo activo en el panel</description>
    </key>

    <!-- Quick Text -->
    <key type="b" name="qt-enabled">
      <default>true</default>
      <summary>Habilitar Quick Text</summary>
      <description>Permite capturar notas rápidas mediante atajo de teclado</description>
    </key>

    <key type="as" name="qt-hotkey">
      <default><![CDATA[['<Ctrl><Super>i']]]></default>
      <summary>Atajo para abrir el diálogo</summary>
    </key>

    <key type="s" name="qt-filepath">
      <default>"/home/owl/notes.txt"</default>
      <summary>Ruta del archivo de notas</summary>
      <description>Ruta absoluta al archivo de texto donde se guardarán las notas</description>
    </key>

    <key type="s" name="qt-pendlocation">
      <choices>
        <choice value="BEG"/>
        <choice value="END"/>
      </choices>
      <default>'BEG'</default>
      <summary>Posición de la nota</summary>
      <description>Agregar la nota al principio (BEG) o al final (END) del archivo</description>
    </key>

    <key type="s" name="qt-append">
      <default>"-----"</default>
      <summary>Separador entre notas</summary>
    </key>

    <key type="s" name="qt-prepend">
      <default>""</default>
      <summary>Prefijo de cada nota (vacío = fecha actual)</summary>
    </key>

    <key type="b" name="qt-multiline">
      <default>false</default>
      <summary>Entrada de una sola línea</summary>
      <description>Si está activo, la entrada es de una línea (Enter guarda la nota)</description>
    </key>

    <key type="b" name="qt-hideacted">
      <default>true</default>
      <summary>Ocultar notas procesadas</summary>
      <description>Oculta las notas marcadas como procesadas en la ventana de acciones</description>
    </key>

    <!-- Background Widgets (master) -->
    <key type="b" name="background-widgets-enabled">
      <default>true</default>
      <summary>Habilitar widgets de escritorio</summary>
      <description>Activa o desactiva todos los widgets de escritorio (reloj, imagen, etc.)</description>
    </key>

    <!-- Background Clock -->
    <key type="b" name="background-clock-enabled">
      <default>false</default>
      <summary>Habilitar reloj de fondo</summary>
      <description>Muestra un reloj superpuesto en el escritorio</description>
    </key>

    <key type="i" name="background-clock-position">
      <range min="0" max="8"/>
      <default>8</default>
      <summary>Posición en pantalla</summary>
      <description>Posición en cuadrícula 3x3 (0=sup-izq, 1=sup-centro, 2=sup-der, 3=medio-izq, 4=centro, 5=medio-der, 6=inf-izq, 7=inf-centro, 8=inf-der)</description>
    </key>

    <key type="i" name="background-clock-x-offset">
      <default>0</default>
      <summary>Desplazamiento horizontal</summary>
      <description>Desplazamiento horizontal en píxeles</description>
    </key>

    <key type="i" name="background-clock-y-offset">
      <default>30</default>
      <summary>Desplazamiento vertical</summary>
      <description>Desplazamiento vertical en píxeles</description>
    </key>

    <key type="b" name="background-clock-enable-clock">
      <default>true</default>
      <summary>Mostrar hora</summary>
    </key>

    <key type="s" name="background-clock-clock-format">
      <default>"%I:%M %p"</default>
      <summary>Formato de hora</summary>
      <description>Formato strftime para la hora (ej: %H:%M para 24h, %I:%M %p para 12h)</description>
    </key>

    <key type="i" name="background-clock-clock-size">
      <range min="8" max="200"/>
      <default>64</default>
      <summary>Tamaño de la hora</summary>
      <description>Tamaño de fuente para la hora en puntos</description>
    </key>

    <key type="b" name="background-clock-clock-custom-font">
      <default>false</default>
      <summary>Fuente personalizada para la hora</summary>
    </key>

    <key type="s" name="background-clock-clock-font">
      <default>"Monospace"</default>
      <summary>Fuente de la hora</summary>
    </key>

    <key type="s" name="background-clock-clock-color">
      <default>"#ffffff"</default>
      <summary>Color de la hora</summary>
    </key>

    <key type="i" name="background-clock-clock-shadow-x">
      <default>0</default>
      <summary>Sombra de hora: X</summary>
    </key>

    <key type="i" name="background-clock-clock-shadow-y">
      <default>0</default>
      <summary>Sombra de hora: Y</summary>
    </key>

    <key type="i" name="background-clock-clock-shadow-blur">
      <default>0</default>
      <summary>Sombra de hora: desenfoque</summary>
    </key>

    <key type="i" name="background-clock-clock-shadow-width">
      <default>0</default>
      <summary>Sombra de hora: ancho</summary>
    </key>

    <key type="s" name="background-clock-clock-shadow-color">
      <default>"#000000"</default>
      <summary>Sombra de hora: color</summary>
    </key>

    <key type="b" name="background-clock-enable-date">
      <default>true</default>
      <summary>Mostrar fecha</summary>
    </key>

    <key type="s" name="background-clock-date-format">
      <default>"%A, %d de %B"</default>
      <summary>Formato de fecha</summary>
      <description>Formato strftime para la fecha</description>
    </key>

    <key type="i" name="background-clock-date-size">
      <range min="8" max="200"/>
      <default>24</default>
      <summary>Tamaño de la fecha</summary>
    </key>

    <key type="b" name="background-clock-date-custom-font">
      <default>false</default>
      <summary>Fuente personalizada para la fecha</summary>
    </key>

    <key type="s" name="background-clock-date-font">
      <default>"Monospace"</default>
      <summary>Fuente de la fecha</summary>
    </key>

    <key type="s" name="background-clock-date-color">
      <default>"#eeeeee"</default>
      <summary>Color de la fecha</summary>
    </key>

    <key type="i" name="background-clock-date-shadow-x">
      <default>0</default>
      <summary>Sombra de fecha: X</summary>
    </key>

    <key type="i" name="background-clock-date-shadow-y">
      <default>0</default>
      <summary>Sombra de fecha: Y</summary>
    </key>

    <key type="i" name="background-clock-date-shadow-blur">
      <default>0</default>
      <summary>Sombra de fecha: desenfoque</summary>
    </key>

    <key type="i" name="background-clock-date-shadow-width">
      <default>0</default>
      <summary>Sombra de fecha: ancho</summary>
    </key>

    <key type="s" name="background-clock-date-shadow-color">
      <default>"#000000"</default>
      <summary>Sombra de fecha: color</summary>
    </key>

    <key type="s" name="background-clock-bg-color">
      <default>"rgba(0,0,0,0)"</default>
      <summary>Color de fondo</summary>
      <description>Color de fondo del contenedor del reloj</description>
    </key>

    <key type="i" name="background-clock-bg-padding">
      <default>12</default>
      <summary>Padding interno</summary>
    </key>

    <key type="i" name="background-clock-bg-border-size">
      <default>0</default>
      <summary>Ancho del borde</summary>
    </key>

    <key type="s" name="background-clock-bg-border-color">
      <default>"#ffffff"</default>
      <summary>Color del borde</summary>
    </key>

    <key type="i" name="background-clock-bg-border-radius">
      <default>0</default>
      <summary>Radio del borde</summary>
    </key>

    <key type="b" name="background-clock-bg-shadow-inset">
      <default>false</default>
      <summary>Sombra interior</summary>
    </key>

    <key type="i" name="background-clock-bg-shadow-x">
      <default>0</default>
      <summary>Sombra de fondo: X</summary>
    </key>

    <key type="i" name="background-clock-bg-shadow-y">
      <default>0</default>
      <summary>Sombra de fondo: Y</summary>
    </key>

    <key type="i" name="background-clock-bg-shadow-blur">
      <default>0</default>
      <summary>Sombra de fondo: desenfoque</summary>
    </key>

    <key type="i" name="background-clock-bg-shadow-width">
      <default>0</default>
      <summary>Sombra de fondo: ancho</summary>
    </key>

    <key type="s" name="background-clock-bg-shadow-color">
      <default>"#000000"</default>
      <summary>Sombra de fondo: color</summary>
    </key>

    <!-- User Avatar (Quick Settings Avatar) -->
    <key type="b" name="user-avatar-enabled">
      <default>true</default>
      <summary>Habilitar avatar de usuario</summary>
      <description>Muestra el avatar del usuario en el menú de ajustes rápidos</description>
    </key>

    <key type="i" name="ua-mode">
      <default>1</default>
      <summary>Modo del avatar</summary>
    </key>

    <key type="i" name="ua-position">
      <default>0</default>
      <summary>Posición del avatar</summary>
      <description>0: derecha, 1: izquierda</description>
    </key>

    <key type="i" name="ua-size">
      <range min="15" max="75"/>
      <default>43</default>
      <summary>Tamaño del avatar</summary>
      <description>Tamaño del ícono del avatar en píxeles</description>
    </key>

    <key type="b" name="ua-realname">
      <default>false</default>
      <summary>Mostrar nombre real</summary>
      <description>Muestra el nombre real del usuario junto al avatar</description>
    </key>

    <key type="b" name="ua-username">
      <default>false</default>
      <summary>Mostrar nombre de usuario</summary>
      <description>Muestra el nombre de usuario UNIX junto al avatar</description>
    </key>

    <key type="b" name="ua-hostname">
      <default>false</default>
      <summary>Mostrar nombre del equipo</summary>
      <description>Muestra el nombre del equipo junto al avatar</description>
    </key>

    <key type="b" name="ua-nobackground">
      <default>true</default>
      <summary>Quitar fondo del botón</summary>
      <description>Elimina el fondo predeterminado del botón de ajustes</description>
    </key>

    <!-- Quick Settings Tweaks -->
    <key type="b" name="qst-enabled">
      <default>false</default>
      <summary>Habilitar Quick Settings Tweaks</summary>
      <description>Activa las mejoras del menú de configuración rápida</description>
    </key>

    <key type="b" name="qst-toggles-enabled">
      <default>true</default>
      <summary>Habilitar ordenamiento de toggles</summary>
      <description>Permite reordenar y ocultar los toggles del menú de configuración rápida</description>
    </key>

    <key type="aa{sv}" name="qst-toggles-order">
      <default><![CDATA[
        [
